# Internal or service-network URL. Do not expose this as NEXT_PUBLIC_*.
OPERATIONS_API_URL=http://localhost:8080

# Browser and WebView connect to the Chat Resource Server directly.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8081

# Optional store links. The install banner stays hidden while these are empty.
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=

# Optional forced-update policy. Leave empty to disable.
# Configure a minimum only after the matching store build is available.
IOS_MINIMUM_BUILD_VERSION=
ANDROID_MINIMUM_BUILD_VERSION=

# Optional Universal Link / App Link verification values.
APPLE_TEAM_ID=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=

# Optional BFF/upstream adapter that persists push tokens for authenticated users.
PUSH_TOKEN_UPSTREAM_URL=

# Must match EXPO_PUBLIC_APP_SCHEME in apps/mobile.
MOBILE_APP_SCHEME=nextwebview
