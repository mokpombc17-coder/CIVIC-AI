{
  "name": "next-expo-webview-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @app/web --filter @app/mobile run dev",
    "dev:web": "pnpm --filter @app/web run dev",
    "dev:mobile": "pnpm --filter @app/mobile run dev",
    "build": "pnpm run build:web",
    "build:web": "pnpm --filter @app/web run build",
    "start:web": "pnpm --filter @app/web run start",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "pnpm -r --if-present run clean",
    "codegraph": "codegraph",
    "codegraph:status": "codegraph status --json",
    "codegraph:sync": "codegraph sync",
    "codegraph:docs": "bash scripts/generate-codegraph-docs.sh"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "prettier": "3.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
