# iOS Simulator or Android with `adb reverse tcp:3000 tcp:3000`
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000

# Optional. Universal Link / App Link host, without protocol.
# Leave empty until a verified production domain exists.
EXPO_PUBLIC_APP_HOST=

# Stable native callback scheme. Changing this requires rebuilding the app.
EXPO_PUBLIC_APP_SCHEME=nextwebview

# Native identifiers. Replace before the first store build.
IOS_BUNDLE_IDENTIFIER=com.example.nextwebviewshell
ANDROID_PACKAGE_NAME=com.example.nextwebviewshell

# Optional. Filled by `eas init`; required before requesting an Expo push token.
EAS_PROJECT_ID=

# Capabilities stay compiled into the app. Permission prompts only happen after
# an explicit request from the web app.
EXPO_PUBLIC_OAUTH_ENABLED=false
EXPO_PUBLIC_DOWNLOADS_ENABLED=true
EXPO_PUBLIC_PUSH_ENABLED=false

# Optional comma-separated CDN origins for native downloads.
EXPO_PUBLIC_DOWNLOAD_ORIGINS=
